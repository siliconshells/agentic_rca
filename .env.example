# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required, and only for live runs —
# `pytest` and any `--mock` run are hermetic.

ANTHROPIC_API_KEY=

# --- budgets -------------------------------------------------------------------------
# Hard ceiling per run. The harness aborts and reports partial results above this.
AEGIS_BUDGET__MAX_COST_USD=2.0
AEGIS_BUDGET__MAX_WALL_CLOCK_S=900

# --- MCP -----------------------------------------------------------------------------
# Streamable HTTP endpoint (docker compose). Set AEGIS_MCP_STDIO=1 to spawn it locally instead.
AEGIS_MCP_URL=http://localhost:8765/mcp
AEGIS_MCP_STDIO=0

# --- telemetry -----------------------------------------------------------------------
# Empty disables OTLP export. Compose sets this to the Jaeger collector.
AEGIS_OTEL_ENDPOINT=
AEGIS_LOG_LEVEL=INFO
AEGIS_LOG_JSON=0
